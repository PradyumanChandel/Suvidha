# Copy to ".env" for testing on your computer. On Render, add these in "Environment Variables".
# NEVER upload the real .env file anywhere.

# --- Email (booking and partner emails come to you) ---
GMAIL_USER=hyperstorage19@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
OWNER_EMAIL=hyperstorage19@gmail.com

# --- Database (stores bookings so you can manage them and customers can track them) ---
# Create a free PostgreSQL database (Render, Neon or Supabase) and paste its connection URL here.
DATABASE_URL=

# --- Admin dashboard at /admin ---
# Use a long, unique password (at least 12 characters). Without it the dashboard stays switched off.
ADMIN_PASSWORD=
# A long random text (30+ characters). It signs your admin login. Change it if you think it leaked.
SESSION_SECRET=

# --- Optional ---
# Your final website address(es), separated by commas, for extra protection. Leave empty until your domain works.
SITE_URL=
